# ==============================================================================
# CareFlow Master Environment Variables Reference
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. BACKEND RUNTIME & DATABASE (backend/.env or Render Service Env)
# ------------------------------------------------------------------------------
NODE_ENV=production
PORT=5000
LOG_LEVEL=info

# MongoDB Atlas Connection String
MONGO_URI=mongodb+srv://careflow_admin:<password>@cluster0.abcde.mongodb.net/careflow?retryWrites=true&w=majority

# JWT Signing Keys (Generate with: openssl rand -base64 32)
JWT_SECRET=production_super_secure_jwt_signing_key_min_32_chars_careflow
JWT_REFRESH_SECRET=production_super_secure_jwt_refresh_key_min_32_chars_careflow

# CORS & Frontend Origins (Comma-separated for multiple environments)
FRONTEND_URL=https://careflow-healthcare.vercel.app
CLIENT_URL=https://careflow-healthcare.vercel.app
ALLOWED_ORIGINS=https://careflow-healthcare.vercel.app,http://localhost:5173

# Cross-Domain Cookie Settings (Set none/true for Render backend + Vercel frontend)
COOKIE_SAME_SITE=none
COOKIE_SECURE=true

# Google AI / Gemini API Configuration
# Get key: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=AIzaSyYourGeminiApiKeyHere
LLM_MODEL=gemini-flash-latest

# Google Cloud OAuth 2.0 Credentials (Calendar OAuth + GIS Login Verification)
# Get credentials: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_CLIENT_SECRET
GOOGLE_REDIRECT_URI=https://careflow-api.onrender.com/api/calendar/callback

# Redis Caching (Optional - Upstash or Redis Cloud)
REDIS_URL=rediss://default:YOUR_REDIS_PASSWORD@your-redis-instance.upstash.io:6379

# Sentry Error Tracking (Optional)
SENTRY_DSN=https://your_backend_sentry_dsn@sentry.io/project-id

# Transactional SMTP Email (Resend / SendGrid / Brevo / Gmail)
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=resend
SMTP_PASS=re_YOUR_SMTP_API_KEY
EMAIL_FROM=CareFlow <notifications@yourdomain.com>


# ------------------------------------------------------------------------------
# 2. FRONTEND CLIENT (frontend/.env or Vercel Project Env)
# ------------------------------------------------------------------------------
VITE_API_BASE_URL=https://careflow-api.onrender.com/api
VITE_SOCKET_URL=https://careflow-api.onrender.com
VITE_GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com
VITE_SENTRY_DSN=https://your_frontend_sentry_dsn@sentry.io/project-id
