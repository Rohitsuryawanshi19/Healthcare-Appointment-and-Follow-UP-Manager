# ==============================================================================
# CareFlow Backend - Production & Development Environment Variables
# ==============================================================================

# Server Runtime
PORT=5000
NODE_ENV=production
LOG_LEVEL=info

# Database Connection (MongoDB Atlas in Production, Local in Development)
# Atlas format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/careflow?retryWrites=true&w=majority
MONGO_URI=mongodb+srv://careflow_admin:YOUR_SECURE_PASSWORD@cluster0.abcde.mongodb.net/careflow?retryWrites=true&w=majority

# JWT Authentication & Session Security (Must be 32+ random characters in production)
# Generate with: openssl rand -base64 32
JWT_SECRET=production_super_secure_jwt_signing_key_min_32_chars_careflow
JWT_REFRESH_SECRET=production_super_secure_jwt_refresh_key_min_32_chars_careflow

# CORS & Cookie Domain Security
# Set to your production Vercel frontend URL (comma-separated for multiple origins)
FRONTEND_URL=https://careflow-healthcare.vercel.app
CLIENT_URL=https://careflow-healthcare.vercel.app
ALLOWED_ORIGINS=https://careflow-healthcare.vercel.app,http://localhost:5173

# Cookie Security Settings:
# In cross-domain prod (e.g. Render backend + Vercel frontend): COOKIE_SAME_SITE=none, COOKIE_SECURE=true
# In same-domain / dev setup: COOKIE_SAME_SITE=lax, COOKIE_SECURE=false
COOKIE_SAME_SITE=none
COOKIE_SECURE=true

# Google AI / Gemini API Configuration (Triage & Clinical Summaries)
# Obtain from Google AI Studio: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=AIzaSyYOUR_GEMINI_API_KEY_HERE
LLM_MODEL=gemini-flash-latest

# Google Cloud OAuth 2.0 Credentials (Calendar Sync & Sign-In Token Verification)
# Obtain from Google Cloud Console: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_CLIENT_SECRET
GOOGLE_REDIRECT_URI=https://careflow-api.onrender.com/api/calendar/callback

# Redis Caching (Optional - 60s TTL Doctor Caching; Upstash or Redis Cloud)
# Format: rediss://default:<password>@<host>:<port>
REDIS_URL=rediss://default:YOUR_REDIS_PASSWORD@your-redis-instance.upstash.io:6379

# Sentry Error Tracking (Optional - Backend Crash Reporting)
# Obtain from: https://sentry.io
SENTRY_DSN=https://your_backend_sentry_dsn@sentry.io/project-id

# Transactional Email (Nodemailer - Resend / SendGrid / Brevo / Gmail SMTP)
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=resend
SMTP_PASS=re_YOUR_SMTP_API_KEY
EMAIL_FROM=CareFlow Notifications <notifications@yourdomain.com>
