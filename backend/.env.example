# ==========================================
# CareFlow Backend Production Environment Configuration
# ==========================================

# Server Port & Environment
PORT=5000
NODE_ENV=production

# MongoDB Production Connection String
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/careflow?retryWrites=true&w=majority

# JWT Authentication Secret (Minimum 32 random characters)
JWT_SECRET=your_super_secret_jwt_signing_key_min_32_chars_long

# CORS Allowed Client Origins (Comma-separated for multiple domains)
CLIENT_URL=https://careflow.yourdomain.com
TRUSTED_ORIGINS=https://careflow.yourdomain.com,https://admin.careflow.yourdomain.com

# AI Pre-Visit & Post-Visit Engine (Google Gemini API Key)
GEMINI_API_KEY=your_gemini_api_key_here
AI_API_KEY=your_gemini_api_key_here
LLM_MODEL=gemini-1.5-flash

# Transactional Email Service (Nodemailer / SMTP)
EMAIL_HOST=smtp.sendgrid.net
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=apikey
EMAIL_PASSWORD=your_smtp_api_key_or_password
EMAIL_FROM=CareFlow Healthcare <notifications@yourdomain.com>

# Google OAuth 2.0 Credentials (Used for GIS Google Sign-In & Calendar Sync)
# Must match the OAuth 2.0 Client ID created in Google Cloud Console (Type: Web Application)
# Ensure Authorized JavaScript Origins include your frontend URL (e.g., http://localhost:5173, https://your-vercel-domain.app)
GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret
GOOGLE_REDIRECT_URI=https://api.careflow.yourdomain.com/api/calendar/callback
