# ==========================================
# CareFlow Frontend Environment Configuration
# ==========================================

# Backend API Endpoint Base URL (leave empty or '/api' when using nginx/reverse-proxy)
VITE_API_BASE_URL=https://api.careflow.yourdomain.com/api
VITE_APP_TITLE=CareFlow Healthcare Platform

# Google Identity Services (GIS) Web Client ID (matches Google Cloud Console Web OAuth Client)
VITE_GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com
