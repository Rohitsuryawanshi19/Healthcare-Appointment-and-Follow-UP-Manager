# ==============================================================================
# CareFlow Frontend - Environment Variables
# ==============================================================================

# Backend API Base URL
# Local dev: /api (Vite dev proxy forwards to http://localhost:5000)
# Production (Vercel): https://<your-render-backend>.onrender.com/api
VITE_API_BASE_URL=https://careflow-api.onrender.com/api

# Real-Time WebSocket Server URL (Socket.IO)
# Local dev: http://localhost:5000 (or empty to use origin)
# Production (Vercel): https://<your-render-backend>.onrender.com
VITE_SOCKET_URL=https://careflow-api.onrender.com

# Google Identity Services (GIS) OAuth 2.0 Web Client ID
# Obtain from Google Cloud Console -> Credentials -> OAuth 2.0 Client IDs (Web application)
# Must match backend GOOGLE_CLIENT_ID
VITE_GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com

# Sentry Error Tracking (Optional - Frontend Crash Reporting)
# Obtain from Sentry -> React Project DSN
VITE_SENTRY_DSN=https://your_frontend_sentry_dsn@sentry.io/project-id
